# ─── OryxShield — Backend Environment Variables ─────────────────────
# Copy this file to .env and fill in the values for your environment.
# NEVER commit .env to version control.

# ─── Django Core ─────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ─── Database ────────────────────────────────────────────────────────────────
# Option A: full URL (preferred for cloud deployments)
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/oryxshield

# Option B: individual vars (used if DATABASE_URL is not set)
DB_NAME=oryxshield
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── Celery ──────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ─── Email ───────────────────────────────────────────────────────────────────
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@oryxshield.gov.na

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Access token lifetime in minutes; refresh in days
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ─── Sentry (production error tracking — leave blank for dev) ────────────────
SENTRY_DSN=

# ─── External Integrations (leave blank; will be populated in production) ────
# These credentials are NOT required for synthetic/seed data mode.
# They will be configured when real API access is granted.
DHIS2_API_URL=
DHIS2_USERNAME=
DHIS2_PASSWORD=
SORMAS_API_URL=
SORMAS_USERNAME=
SORMAS_PASSWORD=

# ─── Push Notifications (Firebase Cloud Messaging v1) ────────────────────────
# Set PUSH_NOTIFICATION_PROVIDER=fcm to enable real mobile push.
# Provide ONE of: FCM_SERVICE_ACCOUNT_JSON (file path) or FCM_SERVICE_ACCOUNT_DICT (JSON string)
PUSH_NOTIFICATION_PROVIDER=local
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
# FCM_SERVICE_ACCOUNT_DICT={"type":"service_account","project_id":"..."}  # for env-only deploys

# ─── Encryption ───────────────────────────────────────────────────────────────
# 32-byte Fernet key for encrypting integration credentials.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# ─── Feature Flags ────────────────────────────────────────────────────────────
ENABLE_TWO_FACTOR_AUTH=False
ENABLE_ML_PREDICTIONS=True
ENABLE_REAL_TIME_ALERTS=True

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: password for seeded demo users (random if unset)
SEED_USER_PASSWORD=
