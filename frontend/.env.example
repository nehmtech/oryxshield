# ─── OryxShield — Frontend Environment Variables ────────────────────
# Copy this file to .env and fill in values for your environment.
# NEVER commit .env to version control.
# All vars must be prefixed with VITE_ to be accessible in the browser bundle.

# ─── API ─────────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/ws

# ─── App ─────────────────────────────────────────────────────────────────────
VITE_APP_NAME=OryxShield
VITE_APP_ENV=development
